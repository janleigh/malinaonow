{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"@/*": ["./src/*"],
			"@shared/*": ["./src/shared/*"],
			"@hooks/*": ["./src/hooks/*"],
		}
	},
	"include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"],
	"exclude": [
		"node_modules",
		"babel.config.js",
		"metro.config.js",
	]
}
