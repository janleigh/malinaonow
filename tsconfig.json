{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["*"],
			"@src/*": ["src/*"],
			"@components/*": ["src/components/*"],
			"@lib/*": ["src/lib/*"],
			"@hooks/*": ["src/hooks/*"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		".expo/types/**/*.ts",
		"expo-env.d.ts",
		"nativewind-env.d.ts"
	],
	"exclude": [
		"node_modules",
		"babel.config.js",
		"metro.config.js",
	]
}
